# Copy to .env. Replace every change-me value before deployment.
SECRET_KEY=change-me-use-at-least-32-random-bytes
JWT_SECRET_KEY=change-me-use-a-different-32-byte-random-value
MONGO_ROOT_USERNAME=app_root
MONGO_ROOT_PASSWORD=change-me-with-a-long-random-password
COOKIE_SECURE=true
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
MAX_UPLOAD_MB=5

# Optional initial administrator. Run: docker compose run --rm user-service python create_admin.py
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-running-bootstrap

# Optional monitoring profile credentials.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
